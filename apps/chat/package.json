{
  "name": "@owobilum/chat",
  "version": "0.0.0",
  "private": true,
  "nx": {
    "name": "chat",
    "tags": [
      "scope:chat"
    ],
    "targets": {
      "typecheck": {
        "command": "tsc -p tsconfig.json && tsc -p tsconfig.spec.json",
        "options": {
          "cwd": "{projectRoot}"
        },
        "cache": true,
        "inputs": [
          "default",
          "^default",
          {
            "externalDependencies": [
              "typescript"
            ]
          }
        ],
        "outputs": [
          "{projectRoot}/out-tsc/*.tsbuildinfo"
        ],
        "metadata": {
          "description": "Nx doesn't infer typecheck for Next.js apps (see @nx/js/typescript), so it is explicit here."
        },
        "dependsOn": [
          "^typecheck"
        ]
      }
    }
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@google/genai": "^2.29.0",
    "@owobilum/ui": "*",
    "next": "~16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3"
  }
}
