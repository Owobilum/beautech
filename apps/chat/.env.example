# Copy to .env.local (gitignored) and fill in. Read on the server only:
# none of these are NEXT_PUBLIC_, so they never reach the browser bundle.

# Google AI Studio key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash

# Optional. "mock" uses the scripted offline provider (used by e2e tests).
# AI_PROVIDER=mock
