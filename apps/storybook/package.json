{
  "name": "@owobilum/storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@owobilum/ui": "*"
  },
  "nx": {
    "name": "storybook",
    "tags": [
      "scope:storybook"
    ],
    "targets": {
      "chromatic": {
        "command": "chromatic --config-file chromatic.config.json",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "build-storybook"
        ],
        "cache": false
      }
    }
  }
}
