{
  "name": "@owobilum/styles",
  "version": "0.0.1",
  "description": "Design tokens and Tailwind CSS v4 theme for the @owobilum design system.",
  "license": "MIT",
  "author": "Lawrence Ikpebe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Owobilum/beautech.git",
    "directory": "packages/styles"
  },
  "homepage": "https://github.com/Owobilum/beautech/tree/main/packages/styles#readme",
  "bugs": {
    "url": "https://github.com/Owobilum/beautech/issues"
  },
  "keywords": [
    "design-tokens",
    "tailwindcss",
    "theme",
    "css",
    "design-system"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "CHANGELOG.md",
    "src"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "style": "./src/index.css",
      "default": "./src/index.css"
    },
    "./theme.css": {
      "style": "./src/theme.css",
      "default": "./src/theme.css"
    },
    "./tokens.css": {
      "style": "./src/tokens.css",
      "default": "./src/tokens.css"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "nx": {
    "name": "styles",
    "tags": [
      "scope:styles"
    ]
  }
}
